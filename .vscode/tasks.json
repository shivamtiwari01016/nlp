{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Train support ticket model",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"ticket_triage.train"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run support ticket API",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"uvicorn",
				"ticket_triage.api:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Smoke test ticket API",
			"type": "shell",
			"command": "python",
			"args": [
				"scripts/smoke_api.py"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test support ticket project",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pytest",
				"-q"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run support triage frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev",
				"--prefix",
				"frontend",
				"--",
				"--host",
				"127.0.0.1",
				"--port",
				"5173"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build support triage frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build",
				"--prefix",
				"frontend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Update frontend lint dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"--prefix",
				"frontend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"lint",
				"--prefix",
				"frontend"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Python development tools",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"pip",
				"install",
				"-e",
				".[dev]"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run Ruff checks",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"ruff",
				"check",
				"src",
				"tests"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}